# Zoho Recruit OAuth (Self Client)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://recruit.zoho.com

# GitHub (Personal Access Token) - used to verify project links in resumes
GITHUB_TOKEN=

# Anthropic (Claude) - used for resume extraction and deep analysis synthesis
ANTHROPIC_API_KEY=

# Google Gemini - TEMPORARY free-tier stand-in while ANTHROPIC_API_KEY isn't
# available. Used only if ANTHROPIC_API_KEY is unset. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local database - defaults to a SQLite file at data/ai_recruiter.db if unset
DATABASE_URL=
